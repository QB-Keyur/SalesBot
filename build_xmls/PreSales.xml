<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Pre-Sales Module Test Cases"
       verbose="10"
       parallel="tests"
       thread-count="3"
       allow-return-values="true">

    <listeners>
        <listener class-name="Utils.RetryListener"/>
    </listeners>

    <test name="Verify Pre-Sales page elements">
        <classes>
            <class name="Tests.PreSalesTest">
                <methods>
                    <include name="verifyPreSalesPageElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify search on Pre-Sales page">
        <classes>
            <class name="Tests.PreSalesTest">
                <methods>
                    <include name="verifySearchOnPreSalesPageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify filters on Pre-Sales page">
        <classes>
            <class name="Tests.PreSalesTest">
                <methods>
                    <include name="verifyFiltersOnPreSalesPageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify sorting on Pre-Sales page">
        <classes>
            <class name="Tests.PreSalesTest">
                <methods>
                    <include name="verifySortingOnPreSalesPageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify view action on Pre-Sales page">
        <classes>
            <class name="Tests.PreSalesTest">
                <methods>
                    <include name="verifyViewActionOnPreSalesPageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify delete action on Pre-Sales page">
        <classes>
            <class name="Tests.PreSalesTest">
                <methods>
                    <include name="verifyDeleteActionOnPreSalesPageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
