<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Order Template Module Test Cases"
       verbose="10"
       parallel="tests"
       thread-count="3"
       allow-return-values="true">

    <listeners>
        <listener class-name="Utils.RetryListener"/>
    </listeners>

    <test name="Navigate to Order Template Page">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="goToOrderTemplatePage"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify Order Template page toolbar elements">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="verifyPageToolbarElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify Order Template create page UI elements">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="verifyCreatePageUIElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify mandatory fields on Order Template">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="verifyMandatoryFields"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify create order template">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="createOrderTemplate"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify read order template">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="readOrderTemplate"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify update order template">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="updateOrderTemplate"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify delete order template">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="deleteOrderTemplate"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify cancel button on Order Template">
        <classes>
            <class name="Tests.OrderTemplateTest">
                <methods>
                    <include name="verifyCancelButton"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
