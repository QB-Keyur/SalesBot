<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Assets Sharing Module Test Cases" verbose="10" parallel="tests" thread-count="3" allow-return-values="true">

    <listeners>
        <listener class-name="Utils.RetryListener"></listener>
    </listeners>

    <!-- Go to Assets Sharing page -->
    <test name="Go to Assets Sharing page">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="goToAssetsSharingPage"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify main page elements -->
    <test name="Verify Assets Sharing main page elements">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyElementsOfMainPage"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify create page elements -->
    <test name="Verify Assets Sharing create page elements">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyElementsOfTheCreatePage"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify mandatory fields -->
    <test name="Verify mandatory fields">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyMandatoryFields"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Create asset -->
    <test name="Create asset with valid data">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="createAnAssetWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Update asset -->
    <test name="Update asset with valid data">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="updateAnAssetWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Cancel button -->
    <test name="Verify cancel button">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyCancelButton"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- View asset -->
    <test name="View asset">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="viewAnAsset"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Delete asset -->
    <test name="Delete asset">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="deleteAnAssetWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Search -->
    <test name="Search asset">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="search"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Horizontal view -->
    <test name="Verify horizontal card view">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyHorizontalCardView"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Pagination -->
    <test name="Verify pagination">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyPagination"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Created date -->
    <test name="Verify created date">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="verifyCreatedDate"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Sorting -->
    <test name="Verify Sorting">
        <classes>
            <class name="Tests.AssetsSharingTest">
                <methods>
                    <include name="validateSorting"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>