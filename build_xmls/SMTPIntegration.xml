<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SMTP Integration Module Test Cases"
       verbose="10"
       parallel="tests"
       thread-count="3"
       allow-return-values="true">

    <!-- Verify SMTP Integration page navigation -->
    <test name="Verify SMTP Integration page navigation">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="goToSMTPIntegrationPage"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP Integration page UI elements -->
    <test name="Verify SMTP Integration page UI elements">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifySMTPIntegrationUIElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP create page UI elements -->
    <test name="Verify SMTP create page UI elements">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifySMTPCreateElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP mandatory field validation -->
    <test name="Verify SMTP mandatory field validation">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifySMTPMandatoryFields"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP integration with whitespace values -->
    <test name="Verify SMTP integration with whitespace values">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyIntegrationWithWhiteSpace"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP integration using valid data -->
    <test name="Verify SMTP integration using valid data">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyIntegratingWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP password view (eye icon) -->
    <test name="Verify SMTP password view eye icon">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyViewEye"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify conversation restriction when SMTP is not connected -->
    <test name="Verify conversation restriction when SMTP is not connected">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyDoesntAllowHavingConversationWhenNotConnected"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify template creation restriction when SMTP is not connected -->
    <test name="Verify template creation restriction when SMTP is not connected">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyDoesntAllowCreatingTemplateWhenNotConnected"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify conversation allowed after SMTP connection -->
    <test name="Verify conversation allowed after SMTP connection">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyAllowsHavingConversationAfterConnecting"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify template creation allowed after SMTP connection -->
    <test name="Verify template creation allowed after SMTP connection">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyAllowsCreatingTemplateAfterConnected"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP disconnect functionality -->
    <test name="Verify SMTP disconnect functionality">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyDisconnecting"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify SMTP integration instruction steps -->
    <test name="Verify SMTP integration steps">
        <classes>
            <class name="Tests.SMTPIntegrationTest">
                <methods>
                    <include name="verifyIntegrationSteps"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
