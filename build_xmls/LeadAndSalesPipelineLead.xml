<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Lead &amp; Sales Pipeline Lead Module Test Cases"
       verbose="10"
       parallel="tests"
       thread-count="3"
       allow-return-values="true">

    <listeners>
        <listener class-name="Utils.RetryListener"/>
    </listeners>

    <test name="Verify Lead pipeline page elements">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifyLeadPipelinePageElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify search on Lead pipeline page">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifySearchOnLeadPipelinePageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify filters on Lead pipeline page">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifyFiltersOnLeadPipelinePageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify sorting on Lead pipeline page">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifySortingOnLeadPipelinePageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify view action on Lead pipeline page">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifyViewActionOnLeadPipelinePageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify edit action on Lead pipeline page">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifyEditActionOnLeadPipelinePageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Verify delete action on Lead pipeline page">
        <classes>
            <class name="Tests.LeadAndSalesPipelineLeadTest">
                <methods>
                    <include name="verifyDeleteActionOnLeadPipelinePageIfDataExists"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
