<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Agent Configuration Module Test Cases"
       verbose="10"
       parallel="tests"
       thread-count="3"
       allow-return-values="true">

    <listeners>
        <listener class-name="Utils.RetryListener"/>
    </listeners>

    <!-- Verify Agent Configuration page navigation -->
    <test name="Verify Agent Configuration page navigation">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="goToAgentConfigurationPage"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify columns and UI elements -->
    <test name="Verify Agent Configuration columns and UI elements">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyColumns"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify search functionality -->
    <test name="Verify Agent Configuration search functionality">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifySearch"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify refresh functionality -->
    <test name="Verify Agent Configuration refresh functionality">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyRefresh"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify sorting functionality -->
    <test name="Verify Agent Configuration sorting functionality">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="validateSorting"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify activate button -->
    <test name="Verify Agent activation using Activate button">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyActivateButton"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify activate button negative scenario -->
    <test name="Verify Activate button negative scenario">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyActiveButtonNegative"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify horizontal view -->
    <test name="Verify Agent Configuration horizontal view">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="horizontalView"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify create page elements -->
    <test name="Verify Create Agent page elements">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyCreatePageElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify edit page elements -->
    <test name="Verify Edit Agent page elements">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyEditPageElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify reset button functionality -->
    <test name="Verify Reset button functionality on Agent form">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyUsingTheResetButton"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify cancel and back button -->
    <test name="Verify Cancel and Back button functionality">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyCancelAndBackButton"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify mandatory field validations -->
    <test name="Verify mandatory field validation for Agent">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="mandatoryFieldVerification"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify adding a new agent -->
    <test name="Verify adding a new Agent with valid data">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="addANewAgentValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify editing an agent -->
    <test name="Verify editing an existing Agent">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="editingAnAgent"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify deleting an agent -->
    <test name="Verify deleting an Agent">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="deletingAnAgent"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify viewing an agent -->
    <test name="Verify viewing Agent details">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="viewAnAgent"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify activate and deactivate functionality -->
    <test name="Verify Agent activate and deactivate functionality">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="activeInactive"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify alternate horizontal views -->
    <test name="Verify alternate horizontal views">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="horizontalViews"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify pagination -->
    <test name="Verify Agent Configuration pagination">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="pagination"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify filters -->
    <test name="Verify Agent Configuration filters">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="filters"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify Playground reflection -->
    <test name="Verify Agent reflection in Playground">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="createAndViewReflectionInPlayground"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify editing effect on created time -->
    <test name="Verify editing effect on Agent created time">
        <classes>
            <class name="Tests.AgentConfigurationTest">
                <methods>
                    <include name="verifyEditingEffectOnCreatedTime"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
