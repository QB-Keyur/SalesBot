<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="WhatsApp Integration Module Test Cases"
       verbose="10"
       parallel="tests"
       thread-count="3"
       allow-return-values="true">

    <listeners>
        <listener class-name="Utils.RetryListener"></listener>
    </listeners>

    <!-- Verify WhatsApp Integration page navigation -->
    <test name="Verify WhatsApp Integration page navigation">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="goToWhatsAppIntegrationPage"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify WhatsApp Integration menu -->
    <test name="Verify WhatsApp Integration menu">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyWhatsAppIntegrationMenu"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify elements inside WhatsApp Integration menu -->
    <test name="Verify elements inside WhatsApp Integration menu">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyElementsInsideWhatsAppIntegrationMenu"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify mandatory field validation -->
    <test name="Verify mandatory field validation in WhatsApp Integration">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyMandatoryFieldValidationInWhatsAppIntegration"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify integration with whitespace values -->
    <test name="Verify WhatsApp integration with whitespace values">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyIntegrationWithWhiteSpaces"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify integration using valid data -->
    <test name="Verify WhatsApp integration using valid data">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyIntegratingWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify view eye icon functionality -->
    <test name="Verify view eye icon functionality">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyViewEye"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify using the same WhatsApp number -->
    <test name="Verify duplicate WhatsApp number usage">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyUsingTheSameNumber"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify elements on edit screen -->
    <test name="Verify WhatsApp Integration edit screen elements">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyElementsInEditScreen"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify disconnecting WhatsApp integration -->
    <test name="Verify disconnecting WhatsApp integration">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyDisconnecting"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify reconnecting the same WhatsApp account -->
    <test name="Verify reconnecting the same WhatsApp account">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyReconnectingSameAccount"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify refresh button functionality -->
    <test name="Verify refresh button functionality">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyRefreshButton"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify conversation allowed after WhatsApp connection -->
    <test name="Verify conversation after WhatsApp connection">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyItAllowsHavingAConversationAfterConnectingWhatsApp"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify WhatsApp template creation after connection -->
    <test name="Verify WhatsApp template creation after connection">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyAllowsCreatingAWhatsAppTemplateAfterConnecting"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Verify restrictions after disconnecting WhatsApp -->
    <test name="Verify restrictions after disconnecting WhatsApp integration">
        <classes>
            <class name="Tests.WhatsAppIntegrationTest">
                <methods>
                    <include name="verifyAfterDisconnectingItDoesntAllowConversationOrTemplate"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
